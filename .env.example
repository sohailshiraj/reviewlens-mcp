# GitHub personal access token. Required.
# Needs at least `repo` scope (or fine-grained "Pull requests: Read" + "Contents: Read")
# for the repos you want to inspect. Never commit a real token.
#
# NOTE: in --http mode this single token is currently shared by every connected
# session (no per-user token exchange yet). Do not use a broadly-scoped token
# for a publicly hosted instance. See README.md "Security" section.
GITHUB_TOKEN=

# Transport selection: "stdio" (default, for Claude Desktop/Cursor/local MCP clients)
# or "http" (Streamable HTTP, for a hosted demo instance). Can also be set via
# the --http CLI flag, which takes precedence over this variable.
REVIEWLENS_TRANSPORT=stdio

# Port for the Streamable HTTP transport. Ignored in stdio mode.
PORT=3000
